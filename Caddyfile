peekaboo.iamrahulraikwar.online {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
	}

	# Cloudflare Origin Certificate terminates the Cloudflare -> origin TLS leg
	# (Cloudflare SSL mode must be "Full (Strict)").
	tls /data/caddy/origin.pem /data/caddy/origin.key

	reverse_proxy peekaboo:8000
}
