SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Base URL of the deployed server, used to build OAuth redirect URLs
PUBLIC_BASE_URL=https://your-service.onrender.com

# Storage backend: "supabase" (default when Supabase env is present) or "sqlite"
STORAGE_BACKEND=sqlite
# SQLite database file (only used when STORAGE_BACKEND=sqlite)
DATABASE_URL=peekaboo.db

# Server-only key used to encrypt integration credentials (e.g. Telegram bot tokens).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional: secret signing short-lived visitor WS tokens. Defaults to ENCRYPTION_KEY.
# WIDGET_SIGNING_SECRET=
# Visitor subscription token lifetime in seconds (default 900).
# VISITOR_TOKEN_TTL_SECONDS=900